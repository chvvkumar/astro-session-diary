# ──────────────────────────────────────────────────────────────
# Astro FITS Cataloger — Environment Configuration
# Copy to .env and edit, or run setup.sh to generate interactively
# ──────────────────────────────────────────────────────────────

# PostgreSQL credentials
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astro_catalog

# Application settings (passed into API + Worker containers)
ASTRO_DATABASE_URL=postgresql+asyncpg://astro:astro@postgres:5432/astro_catalog
ASTRO_REDIS_URL=redis://redis:6379/0
ASTRO_CORS_ORIGINS=["http://192.168.1.100:3000"]
ASTRO_FITS_DATA_PATH=/app/data/fits
ASTRO_THUMBNAILS_PATH=/app/data/thumbnails
ASTRO_THUMBNAIL_MAX_WIDTH=800

# Host paths — mapped into containers as bind mounts
# All three support absolute paths on the host machine
# Run: sudo mkdir -p /docker/astro_cataloger/{thumbnails,postgres}
FITS_DATA_HOST_PATH=/path/to/your/fits/library
THUMBNAILS_HOST_PATH=/docker/astro_cataloger/thumbnails
POSTGRES_DATA_HOST_PATH=/docker/astro_cataloger/postgres
